! ---------------------------------------------------------------------------
! Module 9 : PYTHIA 8 hard QCD 2 -> 2, pp at sqrt(s) = 5.02 TeV, pT-hat biased
!
!   python analysis/m09_quenching.py pp
!
! The pp reference for charged-hadron R_AA from 5 to 100 GeV/c.  A minimum-
! bias sample has almost no events above 20 GeV/c, so the hard 2 -> 2
! scattering is generated with a bias  ~ (pT-hat / 10 GeV)^4  and every event
! carries the compensating WEIGHT (info.weight()).  Every histogram in the
! analysis is weighted.  pTHatMin = 3 GeV: hadrons above 5 GeV/c from
! scatterings below 3 GeV are negligible.
! ---------------------------------------------------------------------------
Beams:idA = 2212
Beams:idB = 2212
Beams:eCM = 5020.

HardQCD:all = on
PhaseSpace:pTHatMin = 3.
PhaseSpace:bias2Selection = on
PhaseSpace:bias2SelectionPow = 4.
PhaseSpace:bias2SelectionRef = 10.

Tune:pp = 14                     ! Monash 2013, as Module 2
ParticleDecays:limitTau0 = on
ParticleDecays:tau0Max = 10.     ! primary particles as ALICE / CMS

Print:quiet = on
Next:numberCount = 0
Random:setSeed = on
Random:seed = 20261122
